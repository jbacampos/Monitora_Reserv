#pragma once

// ============================================================================
//  MODELO das credenciais - versao entram no Git
//
//  Copie este arquivo para include/secrets.h e preencha os valores reais.
//  include/secrets.h e ignorado pelo Git.
//
//  O arquivo e unico para os dois ambientes: a escolha entre TESTE e
//  PRODUCAO continua sendo feita exclusivamente por TEST_MODE (config.h).
// ============================================================================

#include <stdint.h>

// Wi-Fi - teste
constexpr char WIFI_SSID_TEST[]     = "YOUR_TEST_WIFI_SSID";
constexpr char WIFI_PASSWORD_TEST[] = "YOUR_TEST_WIFI_PASSWORD";

// Wi-Fi - producao
constexpr char WIFI_SSID_PROD[]     = "YOUR_PROD_WIFI_SSID";
constexpr char WIFI_PASSWORD_PROD[] = "YOUR_PROD_WIFI_PASSWORD";

// Broker MQTT/TLS (ThingsBoard no Neo). Host e porta sao os mesmos nos dois
// ambientes: MQTT sobre TLS na porta 8883.
constexpr char TB_HOST[]     = "mqtt.datalog.top";
constexpr uint16_t TB_PORT   = 8883;

// Tokens de acesso dos dispositivos no ThingsBoard.
constexpr char TB_ACCESS_TOKEN_TEST[] = "YOUR_TEST_TB_DEVICE_ACCESS_TOKEN";
constexpr char TB_ACCESS_TOKEN_PROD[] = "YOUR_PROD_TB_DEVICE_ACCESS_TOKEN";

// Telegram - Bot API.
//
// O bot e consultado diretamente pelo ESP8266 (sem servico intermediario).
// Somente o(s) chat(s) abaixo podem executar comandos e receber respostas:
// qualquer outro chat e ignorado silenciosamente.
//
// TELEGRAM_CHAT_ID2_* e um segundo chat autorizado OPCIONAL: deixe vazio ("")
// quando nao houver. Os IDs sao tratados como inteiros de 64 bits (grupos comecam
// com "-100" e nao cabem em 32 bits).

// Telegram - teste
constexpr char TELEGRAM_BOT_TOKEN_TEST[] = "1234567890:YOUR_TEST_BOT_TOKEN";
constexpr char TELEGRAM_CHAT_ID_TEST[]   = "-1001234567890";
constexpr char TELEGRAM_CHAT_ID2_TEST[]  = "";

// Telegram - producao
constexpr char TELEGRAM_BOT_TOKEN_PROD[] = "1234567890:YOUR_PROD_BOT_TOKEN";
constexpr char TELEGRAM_CHAT_ID_PROD[]   = "-1000987654321";
constexpr char TELEGRAM_CHAT_ID2_PROD[]  = "";
